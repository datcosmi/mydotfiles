  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/protonvpn-status.sh",
    "interval": 5,
    "return-type": "json",
  },
  "custom/network": {
    "exec": "~/.config/waybar/scripts/network-check.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "nmcli device wifi rescan",
    "format": "{}",
    "tooltip": true,
  },
}
